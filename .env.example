# ==============================================================================
# ScholarSwarm AI — Environment Configuration Template
# Copy this file to .env and configure local values as needed.
# DO NOT commit real API keys or sensitive secrets to version control.
# ==============================================================================

# Application Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite local default, PostgreSQL-compatible)
DATABASE_URL=sqlite:///./scholarswarm.db

# LLM Providers (Gemini / OpenAI)
# Set LLM_PROVIDER to "gemini", "openai", or "mock" (for deterministic local tests)
LLM_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Search & Research API
SEARCH_PROVIDER=mock
TAVILY_API_KEY=your_tavily_api_key_here

# Security & Upload Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx
REQUEST_TIMEOUT_SECONDS=30
WORKFLOW_RETRY_LIMIT=3
MAX_RUN_DURATION_SECONDS=300
